  "quickReference": [
    {
      "title": "Trait Test",
      "rows": [
        [
          "Roll trait die + Wild Die (d6), keep highest. Both ace (explode). Target Number 4 (melee = target's Parry)."
        ]
      ],
      "note": "Every +4 over the TN is a Raise. Critical failure = a 1 on BOTH the trait die and the Wild Die. Extras roll no Wild Die."
    },
    {
      "title": "Damage & Wounds",
      "rows": [
        [
          "Damage total vs Toughness (2 + ½ Vigor + Armor)."
        ],
        [
          "≥ Toughness → Shaken; if already Shaken → +1 Wound; +1 Wound per +4 over Toughness."
        ]
      ],
      "note": "Each Wound: −1 to all trait rolls. 3 Wounds = Incapacitated (Extras drop at 1). Soak: spend a Benny, roll Vigor, each raise removes a Wound."
    },
    {
      "title": "Bennies",
      "rows": [
        [
          "Reroll any trait test · Soak wounds (Vigor) · remove Shaken."
        ]
      ],
      "note": "Refresh to 3 at the start of each session."
    }
  ]
